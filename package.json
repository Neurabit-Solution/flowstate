{
  "name": "flowstate",
  "version": "0.0.1",
  "private": true,
  "description": "Notices when you are in flow and protects it. Camera on only when you say so.",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "make:synthetic": "node scripts/make-synthetic-recording.mjs"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "43.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
